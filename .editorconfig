root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,cjs,mjs,css,html,md}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# PowerShell build scripts
[*.ps1]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
